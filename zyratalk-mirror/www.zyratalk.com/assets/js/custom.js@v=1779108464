  function IsOpened(day, event) {

    if ($(event).is(':checked')) {
        $('#' + day + 'Open')[0].selectedIndex = 0;
        $('#' + day + 'Closed')[0].selectedIndex = 0;

        $('#' + day + 'Open').css('pointer-events', 'none');
        $('#' + day + 'Closed').css('pointer-events', 'none');
        
        $('#' + day + 'Off').removeAttr('checked',false);
        $('#' + day + 'Off').attr('disabled',true);
        
        //  $('#' + day + 'Off').porp('checked',false);
    } else {
        $('#' + day + 'Open').css('pointer-events', '');
        $('#' + day + 'Closed').css('pointer-events', '');
        $('#' + day + 'Off').attr('disabled',false);
        //$('#' + day + 'off').porp('checked',false);
    }
}  
    

