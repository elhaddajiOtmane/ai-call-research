function removeScriptTag(text){
    // VAPT REMOVE SCRIPT TAG
    var SCRIPT_REGEX = /<script\b[^<]*(?:(?!<\/script>)<[^<]*)*<\/script>/gi;
    try{
        if ( SCRIPT_REGEX.test(text) ){
            return text.replace(SCRIPT_REGEX, "");
        }else{
            return text;
        }
    }catch(ex){
        return text;
    }
}
