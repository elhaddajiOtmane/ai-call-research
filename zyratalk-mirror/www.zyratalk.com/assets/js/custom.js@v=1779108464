    $(the).parents('.statewise').find('.appenderror').find('.zipcode_pro_mag').remove();
    $('#travel-zip-form-state .state').not(the).each(function () {

        if ($(this).val() != '') {
            state.push($(this).val());

        }
    });

    console.log(state);

    if ($.inArray(val, state) != -1)
    {

        $(the).parents('.statewise').find('.appenderror').append('<div class="zipcode_pro_mag"><font color="red">This state is already selected.</font></div>');
        $(':input[name="editTravelzip"]').prop('disabled', true);
    }

    //ajax to check if the zip code is alreay in state
    var zipcode = [];
    $(".zipcodeID").each(function (index) {

        if ($(this).val() != '' && $(this).parents('.zipmiles').find('.icheck.zip_mode:checked').val() == 1) {
            zipcode.push($(this).val());

        }
    });


    state.push(val);

    if (!hasDuplicates(state)) {
        $(':input[name="editTravelzip"]').prop('disabled', false);
    }

}

function hasDuplicates(array) {
    var valuesSoFar = [];
    for (var i = 0; i < array.length; ++i) {
        var value = array[i];
        if (valuesSoFar.indexOf(value) !== -1) {
            return true;
        }
        valuesSoFar.push(value);
    }
    return false;
}

