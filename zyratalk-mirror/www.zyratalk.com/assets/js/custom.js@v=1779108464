            }
        });
    }

    if (!$('#text_terms').is(":checked")) {

        error = true;
        $('#text_terms').parent().parent().append('<span class="errormsg help-block has-error help-block-error">Please accept terms and condition</span>');
    }

    //alert(error);
    if (!error) {
        var ser = $('#sendtext').serialize();
        Metronic.blockUI({
            message: "Loading...",
            target: $('#sendtext'),
            overlayColor: '#eee',
            cenrerY: true,
