var FormValidation_notesForm = function () {
    var e = function () {
        var e = $("#notesForm"),
                r = $(".alert-danger", e),
                i = $(".alert-success", e);
        e.validate({
            errorElement: "span",
            errorClass: "help-block help-block-error",
            focusInvalid: !1,
            ignore: "",
            rules: {
                notes: {
                    required: true
                },

            },
            invalidHandler: function (e, t) {
                i.hide(), r.show(), App.scrollTo(r, -200)
            },
            errorPlacement: function (e, r) {
                var i = $(r).parent(".input-group");
                i.size() > 0 ? i.after(e) : r.after(e)
            },
            highlight: function (e) {
                $(e).closest(".form-group").addClass("has-error")
            },
            unhighlight: function (e) {
                $(e).closest(".form-group").removeClass("has-error")
            },
            success: function (e) {
                e.closest(".form-group").removeClass("has-error")
            },
            submitHandler: function (e) {
                i.show(), r.hide();
                
                let notes  = $("#notes").val();
                let chatId = $("#chatId").val();
                let ref = $("#chatRef").val();
                let externalEmail = '';
                var pathName = window.location.pathname;

                if (pathName.indexOf("chat_conversation_usingAuth/") > 0) {
                    externalEmail = $("#pin_email").val();
                }
                if ( $("#team_member_email_id").length > 0 && $("#team_member_email_id").val() !=''){
                    externalEmail = $("#team_member_email_id").val();
                }

                var today = new Date();
                var date = today.getFullYear()+'-'+(today.getMonth()+1)+'-'+today.getDate();
                var time = today.getHours() + ":" + today.getMinutes() + ":" + today.getSeconds();
                var dateTime = date+' '+time;

                var u = new Date().toString().match(/([-\+][0-9]+)\s/)[1];
                var clientTimeZone = u.substring(0, 3) + ':' + u.substring(3, u.length);
                var time_zone = clientTimeZone;
                
                var teamNotes = $.ajax({
                    url: baseurl + "welcome/saveNotes",
                    method: "POST",
                    data: {chatId: chatId,notes:notes,ref:ref,externalEmail:externalEmail,dateTime:dateTime,time_zone:time_zone},
                    cache: false,
                });
                teamNotes.done(function (resp) {
                    let data = JSON.parse(resp);
                    if ( data['html'] !=undefined){
                        $("#notes").val('');
                        if ( $(".c-comment-list").length > 0 ){
                            $(".c-comment-list").prepend(data['html']);
                            $(".c-comment-list").scrollTop(0);
                            
                        }else{
                            let html = `<div class='c-comment-list'>${data['html']}</div>`
                            $(".blog-comments #dynamic_notes").html(html);
                        }
                        
                        $.alert({
                            icon: 'fa fa-check-circle',
                            title: 'Success',
                            content: data['msg'],
                        });
                        
                        loadChatListsForNotes();
                        
                        
                        
                    }
                });

                
            }
        })
    }
    return {
        init: function () {
            e()
        }
    }
}();

