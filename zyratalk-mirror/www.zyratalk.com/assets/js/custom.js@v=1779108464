function calculateTime(start, end) {
    var day = '1/1/1970 ', // 1st January 1970

            diff_in_min = (Date.parse(day + end) - Date.parse(day + start)) / 1000 / 60;
    var diff = false;
    if (diff_in_min < 0) {
        var diff = true;
    }
    return diff;
}
