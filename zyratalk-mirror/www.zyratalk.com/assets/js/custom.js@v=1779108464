                            // Re-enable button as user needs to check email
                            window.loginSubmitting = false;
                            $submitBtn.prop('disabled', false).text(originalBtnText);

                        }else if (chkval == 'Success') {
                                    if(Obj['mfa_auth']==0){
                                        console.log("oo");
                            $('#msg_display').hide();
                            // Metronic.unblockUI($('.main'));
                            if ( Obj.loginRedirect != undefined  ){
                                window.location.href = baseurl + Obj.loginRedirect;
                            }else{
                                window.location.href = baseurl + 'user/dashboard'
                            }
                            //window.location.href = baseurl + 'user/dashboard'
                        } else {
                                        $("#usid").val( Obj['uid']);
                                        $("#ustype").val(Obj['authtype']);
                                    // $("#kt_modal_two_factor_authentication").modal('show');
                                    openMfaModal();
                                    }

                                } else {
                            // Metronic.unblockUI($('.main'));
                            $('#msg_display').show();
                            $('#msg_display span').text(Obj.display);

                            // Auto-hide error message after 3 seconds
                            setTimeout(function() {
                                $('#msg_display').fadeOut();
                            }, 3000);

                            // CRITICAL: Clear captcha token immediately on any login failure
                            $('#verify_token_for_user_login').val('');

                            // Reset reCAPTCHA v2 widget immediately on login failure
                            if (typeof grecaptcha !== 'undefined' && $('#captcha_container').length > 0) {
                                try {
                                    grecaptcha.reset();
                                    console.log('reCAPTCHA widget reset successfully');
                                } catch(e) {
                                    console.log('reCAPTCHA reset failed:', e);
                                }
                            }

                            // Reset token on login failure
                            if (Obj.new_token) {
                                $('#login_token').val(Obj.new_token);
                            }

                            // Check if this is a captcha-related error
                            var isCaptchaError = false;
                            if (Obj.display) {
                                var errorMsg = Obj.display.toLowerCase();
                                if (errorMsg.indexOf('captcha') !== -1 || errorMsg.indexOf('verify') !== -1) {
                                    isCaptchaError = true;
                                }
                            }

                            // Check if captcha is currently visible on the page
                            var captchaContainer = $('#captcha_container');
                            var isCaptchaVisible = captchaContainer.is(':visible');

                            // Handle captcha visibility based on backend response
                            if (Obj.login_attempts !== undefined && Obj.show_captcha !== undefined) {
                                if (captchaContainer.length > 0) {
                                    // Show captcha only if backend says to show it AND attempts >= 3
                                    if (Obj.show_captcha && Obj.login_attempts >= 3) {
                                        captchaContainer.show();
                                        captchaContainer.css('display', 'flex');
                                        isCaptchaError = true;

                                        // Show message about captcha
                                        $('#msg_display span').html(Obj.display + '<br><strong>Please complete the captcha to continue.</strong>');

                                        // If captcha was already visible, it means verification failed - reload
                                        if (isCaptchaVisible) {
                                            console.log('Captcha verification failed - reloading page');
                                            // Re-enable button temporarily
                                            window.loginSubmitting = false;
                                            $submitBtn.prop('disabled', false).text(originalBtnText);

                                            // Reload page after 2 seconds to allow user to see error message
                                            setTimeout(function() {
                                                window.location.reload();
                                            }, 2000);
                                            return;
                                        }

                                        // Re-enable submit button for retry (first time showing captcha)
                                        window.loginSubmitting = false;
                                        $submitBtn.prop('disabled', false).text(originalBtnText);

                                        // Don't reload page - let user retry immediately after solving captcha
                                        return;
                                    } else {
                                        captchaContainer.hide();
                                    }
                                }
                            }

                            // If captcha error detected and captcha is visible, reload page
                            if (isCaptchaError && isCaptchaVisible) {
                                console.log('Captcha verification failed - reloading page');

                                // Reload page after 2 seconds to allow user to see error message
                                setTimeout(function() {
                                    window.location.reload();
                                }, 2000);
                                return;
                            }

                            // For non-captcha errors, wait before redirecting to allow user to read error message
                            setTimeout(function() {
                                document.querySelector('#sign-in-form').reset();
                                // Clear captcha token before redirect
                                $('#verify_token_for_user_login').val('');
                                window.location = baseurl + 'sign-in';
                            }, 2500);
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error('Login AJAX error:', error);
                        $('#msg_display').show();
                        $('#msg_display span').text('An error occurred. Please try again.');

                        // Auto-hide error message after 3 seconds
                        setTimeout(function() {
                            $('#msg_display').fadeOut();
                        }, 3000);

                        // Re-enable submit button on error
                        window.loginSubmitting = false;
                        $submitBtn.prop('disabled', false).text(originalBtnText);

                        // Clear captcha token and reset widget
                        $('#verify_token_for_user_login').val('');
                        if (typeof grecaptcha !== 'undefined' && $('#captcha_container').length > 0) {
                            try {
                                grecaptcha.reset();
                            } catch(e) {
                                console.log('reCAPTCHA reset failed:', e);
                            }
                        }
                    },
                    complete: function() {
                        // Safety net: ensure button is re-enabled after 10 seconds even if something goes wrong
                        setTimeout(function() {
                            if (window.loginSubmitting === true) {
                                console.log('Force re-enabling submit button after timeout');
                                window.loginSubmitting = false;
                                $submitBtn.prop('disabled', false).text(originalBtnText);
                            }
                        }, 10000);
                    }
                });
        }, 2000); // 600ms delay to ensure captcha token is set
        return false;
    }

