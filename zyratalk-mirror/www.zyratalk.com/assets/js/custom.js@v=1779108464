        url: baseurl + "welcome/scheduleDemo",
        data: dataString,
        success: function (response) {
            var obj = JSON.parse(response);
            Metronic.unblockUI($('.contact-form'));
            if (obj.status == "402") {
                if (obj.msg.fname) {
                    jQuery("#fname").after(obj.msg.fname);
                }
                if (obj.msg.lname) {
                    jQuery("#lname").after(obj.msg.lname);
                }
                if (obj.msg.email) {
                    jQuery("#email").after(obj.msg.email);
                }
                if (obj.msg.phone) {
                    jQuery("#phone").after(obj.msg.phone);
                }
                if (obj.msg.company) {
                    jQuery("#company").after(obj.msg.company);
                }
                if (obj.msg.empno) {
                    jQuery("#empno").after(obj.msg.empno);
                }
                setTimeout(function () {
                    //jQuery(".contact-form :input").each(function(){ jQuery(this).next("span").remove();}); 
                }, 3000);

                return false;
            }
            if (obj.status == 200) {
                $('.success').html(obj.msg);
                $('.success').fadeIn(1000);
                $('.overlay').fadeIn(1000);
                setTimeout(function () {
                    $('.success').fadeOut(1000);
                    $('.overlay').fadeOut(1000);
                }, 3000);
                $('#zyra-contact-form').each(function () {
                    this.reset();
                });
            }

            // jQuery("#submit_req").prop("disabled",false);

        }
    });

    return false;
}
