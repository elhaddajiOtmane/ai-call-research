// Initialize all modal handlers
function initModalHandlers() {
    // Reattempt button click handler
    $(document).off('click', '.reattempt-btn').on('click', '.reattempt-btn', function(e) {
        e.preventDefault();
        const callId = $(this).data('id');
        const $button = $(this);
        
        // Store references
        $('#callLogModal').data({
            'call-id': callId,
            'button': $button
        });
        
        // Show confirmation
        showModalSection('confirmReattemptSection');
        $('#callLogModal').modal('show');
    });
    
    // Cancel button handler
    $(document).off('click', '#cancelReattemptBtn').on('click', '#cancelReattemptBtn', function() {
        $('#callLogModal').modal('hide');
    });
    
    // Proceed button handler
    $(document).off('click', '#proceedReattemptBtn').on('click', '#proceedReattemptBtn', function() {
        const callId = $('#callLogModal').data('call-id');
        showModalSection('loadingSection');
        
        $.ajax({
            url: baseurl+'newengage/public/api/update-call-log-status',
            method: 'POST',
            data: {
                _token: '{{ csrf_token() }}',
                call_id: callId,
                call_status: 'reattempt'
            },
            success: function(response) {
                if(response.success) {
                    showSuccessModal(response.message || 'Call reattempted successfully!');
                    updateButtonStatus(response.message === 'false');
                } else {
                    showFailureModal(response.message || 'Failed to update call status');
                }
            },
            error: function(xhr) {
                const errorMsg = xhr.responseJSON?.message || 'Server error';
                showFailureModal(`Error: ${errorMsg}`);
            }
        });
    });
    
    // Success close button
            $(document).off('click', '#successCloseBtn').on('click', '#successCloseBtn', function() {
                $('#callLogModal').modal('hide');
                location.reload(); // Refresh to show updated status
            });
            
            // Failure close button
            $(document).off('click', '#failureCloseBtn').on('click', '#failureCloseBtn', function() {
                $('#callLogModal').modal('hide');
            });
            
            // Retry button
            $(document).off('click', '#retryBtn').on('click', '#retryBtn', function() {
                showModalSection('confirmReattemptSection');
            });
            
            // Reset modal when closed
            $('#callLogModal').off('hidden.bs.modal').on('hidden.bs.modal', function() {
                showModalSection('confirmReattemptSection');
            });
        }

        // Helper function to show specific modal sections
        function showModalSection(sectionId) {
            ['confirmReattemptSection', 'loadingSection', 'successSection', 'failureSection'].forEach(id => {
                $(`#${id}`).hide();
            });
            $(`#${sectionId}`).show();
        }

        // Show success modal
        function showSuccessModal(message) {
            $('#successSection .success-message').text('Inserted Successfully.');
            showModalSection('successSection');
        }

        // Show failure modal
        function showFailureModal(message, details = '') {
            $('#failureSection .error-message').text(message);
            $('#failureSection .error-details').text(details);
            showModalSection('failureSection');
        }

        // Update button status
        function updateButtonStatus(isSuccess) {
            const $button = $('#callLogModal').data('button');
            if (!$button) return;
            
            $button.prop('disabled', true)
                .removeClass('btn-primary')
                .addClass(isSuccess ? 'btn-success' : 'btn-danger')
                .text(isSuccess ? 'Re-attempted' : 'Failed');
        }

        // Initialize everything when DOM is ready
        $(document).ready(function() {
            initReattemptModal();
            initModalHandlers();
        });
	}
};

