function changesmsformate(customval) {
    var textval = $('.' + customval).val();
    var cleaned = ('' + textval).replace(/\D/g, '')
    var match = cleaned.match(/^(\d{3})(\d{3})(\d{4})$/)
    if (match) {
        textval = '(' + match[1] + ')' + match[2] + '-' + match[3];
        $('.' + customval).val(textval);
    } else {
        $('.' + customval).val('');
    }
    $('.' + customval).attr('onkeydown', 'javascript:backspacerDOWN(this,event);');
    $('.' + customval).attr('onkeyup', 'javascript:backspacerUP(this,event);');
    $('.' + customval).attr('placeholder', '(_ _ _)_ _ _-_ _ _');
}

