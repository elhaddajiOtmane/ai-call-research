function customText(e, replaceClass, urlText, first) {
    if (e == '') {
        $('.' + replaceClass).css('display', 'none');
        $('.' + replaceClass).addClass("mh-hide")
        $('input[name=' + urlText + ']').val('');
    } else {
        $('.' + replaceClass).text(e);
        $('.' + replaceClass).removeClass("mh-hide")
        $('.' + replaceClass).css('display', 'inline-block');
    }

    if (e != '') {
        // for duplicate button
        var inputVal = e
        var match = false;

        if (first == 2) {
            var inputVal1 = document.getElementsByName("customButton1")[0].value;
            if (inputVal == inputVal1)
                match = true;
        }

        if (first == 1) {
            var inputVal2 = document.getElementsByName("customButton2")[0].value;
            if (inputVal == inputVal2)
                match = true;
        }

        $("[id^=customButtonID_]").each(function (i) {
            if (inputVal == $(this).val())
                match = true;
        })

        if (match) {
            $('.error-keyup-first-' + first).show();
            $('#duplicateFound').val(1)
        } else {
            $('.error-keyup-first-' + first).hide();
            $('#duplicateFound').val(0)
        }
    } else {
        $('.error-keyup-first-' + first).hide();
    }
}

