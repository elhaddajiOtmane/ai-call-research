                // chart.
                labels: (chartTypes == 'chat') ? [seriesfirstlabel, seriessecondlabel, seriesthirdlabel]: [seriesfirstlabel, seriessecondlabel],
                dateFormat: function (x) {
                    var date = new Date(x),
                            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
                            day = ("0" + date.getDate()).slice(-2);
                    return [mnth, day, date.getFullYear()].join("-");
                },
                xLabelFormat: function (x) {
                    var date = new Date(x),
                            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
                            day = ("0" + date.getDate()).slice(-2);
                    return [mnth, day, date.getFullYear()].join("-");
                },
                xLabels: (frequency == 'alltime' ||  frequency == 'pastyear') ? "month" : "day",
                xLabelAngle: 45,
                lineColors: (chartTypes == "chat") ? ['#0251bf', '#ff494b', '#00C851'] :['#0251bf', '#ff494b']

            });
            graph.setData(seriespoint);
        } else {
            $(".nodatafound").html('No data to display.');
        }
    }


