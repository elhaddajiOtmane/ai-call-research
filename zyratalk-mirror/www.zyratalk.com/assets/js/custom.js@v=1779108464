function checkForPinValidationFirst(Callback) {
    var passValidation = 1;
    var C5 = ($.trim($("#sub_account_name").val()) != "") ? 1 : 0;
    var C1 = ($.trim($("#pin1_first").val()) != "") ? 1 : 0;
    var C2 = ($.trim($("#pin2_first").val()) != "") ? 1 : 0;
    var C3 = ($.trim($("#pin3_first").val()) != "") ? 1 : 0;
    var C4 = ($.trim($("#pin4_first").val()) != "") ? 1 : 0;

    var InvalidNo = false;
    var InvalidAccount = false;

    var CVal5 = $.trim($("#sub_account_name").val());
    if (CVal5 == '') {
        $("#pinValidate").val(CVal1);
        InvalidAccount = true;
    }


    var CVal1 = $.trim($("#pin1_first").val());
    if ($.isNumeric(CVal1) == false) {
        $("#pinValidate").val(CVal1);
        InvalidNo = true;
    }
    var CVal2 = $.trim($("#pin2_first").val());
    if ($.isNumeric(CVal2) == false) {
        $("#pinValidate").val(CVal2);
        InvalidNo = true;
    }
    var CVal3 = $.trim($("#pin3_first").val());
    if ($.isNumeric(CVal3) == false) {
        $("#pinValidate").val(CVal3);
        InvalidNo = true;
    }
    var CVal4 = $.trim($("#pin4_first").val());
    if ($.isNumeric(CVal4) == false) {
        $("#pinValidate").val(CVal4);
        InvalidNo = true;
    }

    var finalC = parseInt(C1) + parseInt(C2) + parseInt(C3) + parseInt(C4);
    if (finalC < 4 || InvalidNo == true || InvalidAccount == true) {
        if (finalC < 4) {
            $("#pin_required-error_first").show();
            $("#pin_numeric-error_first").hide();
            $("#pinBar_first").addClass("has-error-for-pin");
        } else if (InvalidNo == true) {
            $("#pin_required-error_first").hide();
            $("#pin_numeric-error_first").show();
            $("#pinBar_first").addClass("has-error-for-pin");
        } else {
            $("#pin_required-error_first").hide();
            $("#pin_numeric-error_first").hide();
            $("#pinBar_first").removeClass("has-error-for-pin");
        }

        if (InvalidAccount == true) {
            $("#pin_required_account-error_first").show();

            $("#account_first").addClass("has-error-for-pin");
        } else {
            $("#pin_required_account-error_first").hide();

            $("#account_first").removeClass("has-error-for-pin");
        }

        passValidation = 0;
    } else {
        passValidation = 1;
        $("#pinBar").removeClass("has-error-for-pin");
        $("#pin_required-error").hide();
        $("#pin_numeric-error").hide();
    }
    Callback(passValidation);
}


