// Function to sanitize form input by removing HTML tags and allowing only specific characters
function sanitizeInput(input) {
    // Check if input is a string to prevent processing invalid data types
    if (typeof input !== 'string') {
        // Log error for debugging purposes if input is not a string
        console.error("Input must be a string. Received type: ", typeof input);
        // Return input unchanged to avoid breaking the application
        return input;
    }

    // Trim whitespace from both ends of the input to clean up unnecessary spaces
    let sanitized = input.trim();
    
    // Remove all HTML tags to prevent XSS attacks (e.g., <script>, <img>, etc.)
    sanitized = sanitized.replace(/<[^>]*>/g, '');
    
    // Allow only alphanumeric characters, spaces, and specific allowed characters (@, ., #, !)
    // This regex removes any character not in the allowed set
    sanitized = sanitized.replace(/[^a-zA-Z0-9\s@\.#!]/g, '');
    
    // Return the sanitized input
    return sanitized;
}

// Function to apply sanitization to all textarea inputs in a specific form
function sanitizeFormTextareas(formId) {
    // Get the form element by its ID
    const form = document.getElementById(formId);
    if (!form) {
        console.error(`Form with ID ${formId} not found.`);
        return;
    }
    // Get all textarea elements within the form
    const textareas = form.querySelectorAll('textarea');
    // Iterate through each textarea and sanitize its value
    textareas.forEach(textarea => {
        // Store the original value
        const originalValue = textarea.value;
        // Apply sanitization
        textarea.value = sanitizeInput(originalValue);
        // Optional: Log if sanitization changed the input for debugging
        if (originalValue !== textarea.value) {
            console.log(`Sanitized textarea '${textarea.name}': from "${originalValue}" to "${textarea.value}"`);
        }
    });
}

// Event listener for form submission to sanitize inputs before sending
function initializeFormSanitization() {
    // Target the forms used in your HTML
    const forms = ['customresponseBtF', 'customresponseBtFEdit'];
    forms.forEach(formId => {
        const form = document.getElementById(formId);
        if (form) {
            // Add submit event listener to sanitize textareas before form submission
            form.addEventListener('submit', (event) => {
                // Prevent default submission to allow sanitization
                event.preventDefault();
                // Sanitize all textareas in the form
                sanitizeFormTextareas(formId);
                // Optionally: Proceed with form submission after sanitization
                // Uncomment the next line if you want to submit the form programmatically
                // form.submit();
                // For debugging, log that sanitization was applied
                console.log(`Form ${formId} sanitized and ready for submission.`);
            });
            // Optional: Sanitize on input change for real-time cleaning
            form.querySelectorAll('textarea').forEach(textarea => {
                textarea.addEventListener('input', () => {
                    textarea.value = sanitizeInput(textarea.value);
                });
            });
        }
    });
}

// Initialize sanitization when the DOM is fully loaded
