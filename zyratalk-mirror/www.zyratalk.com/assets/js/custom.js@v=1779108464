function maxlengthtextarea(the, max, e) {
    $('.errormsg').remove();
    comment_text = the.value;
    if (e.which < 0x20) {
        // e.which < 0x20, then it's not a printable character
        // e.which === 0 - Not a character
        return;     // Do nothing
    }
    if (the.value.length == max) {
        e.preventDefault();
        $(the).parent().append('<span class="errormsg help-block has-error">Content should not be greater than 160 character</span>');
    } else if (the.value.length > max) {
        // Maximum exceeded
        the.value = the.value.substring(0, max);
    }
    //$('#value')
    if (comment_text.length > 0) {



        $("#quick_text_menu_2 option:first").removeAttr('selected', 'selected');
        $("#quick_text_menu_2 option:first").attr('selected', 'selected');
        $("#quick_text_menu_2").trigger("change");

    }
}

