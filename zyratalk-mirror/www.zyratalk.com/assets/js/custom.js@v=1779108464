    function deteleMemberPhone(phoneNumId) {

        $("#msg_team_phone_display").show();
        showLoader('.page-content');

        var deleteTeam = $.ajax({
            url: baseurl + "user/delete_team_phone",
            data: {phone_num_id: phoneNumId},
            type: "POST"
        });

        deleteTeam.done(function (msg) {
            Metronic.unblockUI($('.page-content'));
            var rsp = JSON.parse(msg);
            if (typeof rsp.message != 'undefined') {
                if (rsp.error == 1) {
                    $("#msg_team_phone_display").removeClass('alert-success').addClass('alert-danger');
                } else {
                    $("#msg_team_phone_display").removeClass('alert-danger').addClass('alert-success');
                }
                $("#msg_team_phone_display #msgTeamID").html(rsp.message);
            }
            if (rsp.error == 0) {
                if (typeof rsp.id != 'undefined') {
                    $("#" + rsp.id).remove();

                    if ($(".yr-mail-innerBox-phone").length <= 0) {
                        $("#phone_head").hide();
                    }


                }
            }
        });

        deleteTeam.fail(function (jqXHR, textStatus) {
            Metronic.unblockUI($('.page-content'));
            $("#msg_team_phone_display #msgTeamID").html("Unable to remove phone number. Please try after sometime.");
        });

        $("#delete-member-confirm-modal").modal('hide');
    }

