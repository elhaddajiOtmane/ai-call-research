function createTicketFormData(image) {

    if (image.length > 0) {
        for (let i = 0; i < image.length; i++) {
            if (image[i].type != '') {
                let imageType = image[i].type.split("/");
                if (imageType.length > 0 && imageType[0].toLowerCase() === 'image') {
                    checkImageType(image[i],function(isValid){
                        if ( isValid ){
                    let formImage = new FormData();
                    formImage.append('dropImage', image[i]);
                    uploadTicketFormData(formImage);
                        }else{
                            $("#infusionsoft_credentails_form_error_log #exampleModalLongTitle").text('File upload');
                            let valdationMessage = `<div class='alert alert-danger' role='alert'>${image[i].name} is not a valid file to upload.Only "jpg, jpeg, png, gif" files are supported.</div>`;
                            $("#infusionsoft_credentails_form_error_log .modal-body").html(valdationMessage);  
                            $("#infusionsoft_credentails_form_error_log").modal();

                        }
                    });
                    

                } else {
                    $("#infusionsoft_credentails_form_error_log #exampleModalLongTitle").text('File upload');
                    let valdationMessage = `<div class='alert alert-danger' role='alert'>${image[i].name} is not a valid file to upload</div>`;
                    $("#infusionsoft_credentails_form_error_log .modal-body").html(valdationMessage);  
                    $("#infusionsoft_credentails_form_error_log").modal();
                }
            }
        }
    }
}



function uploadTicketFormData(formData) {

    $.ajax({
        url: baseurl + "ExternalSupport/upload_files",
        type: "POST",
        data: formData,
        contentType: false,
        cache: false,
        processData: false,
        beforeSend: function () {
            showLoader('#drop-container');
        },
        success: function (response) {

            let data = JSON.parse(response);
            if (data.status === true && data.image_name != '') {
                jQuery("#uploaded_files").append(`<input type="hidden" name="upload_file[]" value='${data.image_name}' />`);
                let imagePreview = $(".drop-image").clone();
                imagePreview.attr("src", baseurl + "assets/uploads/tickets/" + data.image_name);

                imagePreview.removeClass("drop-image");
                imagePreview.addClass("preview");
                $('#drop-container').append(imagePreview);
            } else if (data.status === false) {
                alert('Invalid image mime ' + data.image_name);
            }

        },
        error: function (e) {
            Metronic.unblockUI($('#drop-container'));
        },
        complete: function () {
            Metronic.unblockUI($('#drop-container'));
        }
    });
}

