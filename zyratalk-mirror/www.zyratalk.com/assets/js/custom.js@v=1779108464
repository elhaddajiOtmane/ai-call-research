function check_custom_duplicate_trumpia_value(val) {

    var zipval = val.trim();
    var duplicate = false;

    if (zipval != '')
    {

        var count = 0;
        $(".custom_phone_trumpia").each(function (index) {

            if ($(this).val() == zipval) {
                count = count + 1;

            }
        });
        //console.log(count);
        if (count > 1) {
            duplicate = true;
        }
    }
    return duplicate;
}



function formatephone_numbers(text) {
    return text.replace(/(\d{3})(\d{3})(\d{4})/, '($1)$2-$3');
}

