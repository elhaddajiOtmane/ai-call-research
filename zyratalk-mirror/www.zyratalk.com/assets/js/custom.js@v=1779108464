function approveRejectFinalDone(mMsg, url, user_id, status, addon, msg = '') {
    if (status == "reject") {
        $(".close").trigger("click");
    }
    Metronic.blockUI({
        message: mMsg,
        target: $('.page-content'),
        overlayColor: '#eee',
        cenrerY: true,
        boxed: true,
    });

    $.ajax({
        type: "POST",
        url: url,
        data: {user_id: user_id, addon: addon, msg: msg},
        success: function (data) {
            Metronic.unblockUI($('.page-content'));
            if (data == 0) {
                $('#AccountCannotApprove').modal({backdrop: 'static', keyboard: false});
                return;
            }
            if (addon == 1)
                var Sel = 'VAS';
            else
                var Sel = 'VS';
            if (status == "approve") {
                $("#" + Sel + "_" + user_id).text("Approved");
                if (addon == 0) {
                    $("#BTNADDON_1_" + user_id).removeAttr("disabled");
                    $("#BTNADDON_2_" + user_id).removeAttr("disabled");
                }
            } else {
                msg = msg.replace(/'/g, "\\'")
                if (Sel == "VS")
                    $("#" + Sel + "_" + user_id).html("Rejected <i style='cursor:pointer;' onclick='openreasonForAccount(" + user_id + ")' id='rejectAccountReason_" + user_id + "' rtext='" + msg + "' class='fa fa-info-circle' aria-hidden='true'></i>");
                $("#VAS_" + user_id).html("Rejected <i style='cursor:pointer;' onclick='openreasonForAddon(" + user_id + ")' id='rejectAddonReason_" + user_id + "' rtext='" + msg + "' class='fa fa-info-circle' aria-hidden='true'></i>");
            }

            if (addon == 0) {
                $("#BTN_1_" + user_id).remove();
                $("#BTN_2_" + user_id).remove();
            } else {
                $("#BTNADDON_1_" + user_id).remove();
                $("#BTNADDON_2_" + user_id).remove();
            }

        }
    });
}

