function workinghours() {
    var error = false;
    var errorZone = false;
    $('.selecterror').remove();
    $('.selecterrorhours').remove();
    var timezoneval = $('select[name=timezone]').val();

    if (timezoneval == '') {
        errorZone = true;
    }
    $('.open_td select').each(function (index) {
        var openselectvalue = $(this).val();

        if ($(this).parents('tr').find('.offcheckbox').prop('checked') || $(this).parents('tr').find('.oncheckbox').prop('checked')) {
            
        } else {

            var selectval = $(this).parents('tr').find('.closed_td select').val();


            if (openselectvalue == '' && selectval == '') {
                error = true;
            } else {
                if (openselectvalue != '' && selectval != '') {
                    if (calculateTime(openselectvalue, selectval)) {

                        $(this).parents('tr').find('td.closed_td').append('<span class="selecterror">Closed time will be greater than open time</span>');
                        error = true;
                    }


                } else {
                    if (openselectvalue == '') {

                        $(this).parents('tr').find('td.open_td').append('<span class="selecterror">Please select</span>');

                    }

                    if (selectval == '') {
                        //alert('hi');
                        $(this).parents('tr').find('td.closed_td').append('<span class="selecterror">Please select</span>');
                    }
                    error = true;
                }
                //alert('hi');

                // alert(openselectvalue);

            }


        }
    });

   // if ((errorZone == true && error == false) || (errorZone == false && error == true)) {
      
        if (errorZone == true || error == true) {
        if (errorZone == true)
            $('select[name=timezone]').after('<span class="selecterror">Please Select Time Zone</span>');
        if (errorZone == false)
            $('.yr_day_nav').before('<span class="selecterrorhours" style="color:red">Please select hours of operation</span>');

        return false;
    } else {
        Metronic.blockUI({
            message: "Loading...",
            target: $('.main'),
            overlayColor: '#eee',
            cenrerY: true,
            boxed: true,
        });
        var x = document.getElementsByName("workinghoursname");
