function loadZapierDropDown(locationID = 0,isDefault=false){
    const zapierLocation = $.ajax({
        url: baseurl + "zapier/get_location",
        data: { locationID: locationID},
        type: "POST"
    });

    zapierLocation.done(function (msg) {
        var obj = JSON.parse(msg);
        if (obj.msg == 'success') {
            if ( document.getElementById("location_id") ){
                let options = '';
                if ( obj.locationList.length > 0 ){
                    options = "<option value='0'>Default(All location)</option>";
                    obj.locationList.forEach(function(item){
                        if (parseInt(locationID) > 0 &&  parseInt(item.id) === parseInt(locationID)  ){
                            options += `<option value="${item.id}"  >${item.location}</option>`
                        }else{
                            options += `<option value="${item.id}" ${ parseInt(item.zapier_id) > 0 ? 'disabled' : '' } style="background:${ parseInt(item.zapier_id) > 0 ? '#cccaca' : '' }" >${item.location}</option>`
                        }
                    });
                        
                    $("#location_id").html(options);
                        if ( parseInt(locationID) > 0 ){
                            selectLocation('location_id',locationID);
                        }
                       
                        if ( obj.haveDeafultLocation ){
                          jQuery("#default_location").bootstrapSwitch('disabled',false);
                          if ( isDefault ){
                              jQuery("#default_location").bootstrapSwitch('state',true);
                          }else{
                              jQuery("#default_location").bootstrapSwitch('state',false);
                          }
                        }else{
                          jQuery("#default_location").bootstrapSwitch('state',false);
                          jQuery("#default_location").bootstrapSwitch('disabled',true);
                          
                        }
                }
            }
        }  
    });

    zapierLocation.fail(function (jqXHR, textStatus) {
            Metronic.unblockUI($('.page-conten'));
            alert("Unable to get information about infusionsoft");
    });
}
