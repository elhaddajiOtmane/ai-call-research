    $(document).on('blur', '.zipcodeID', function () {

        var zipval = $(this).val();
        zipval = zipval.trim();
        var t = $(this).parents('.zipmiles').find('.zipcode_pro_mag');
        t.show();
        var state = [];
        if (zipval != '')
        {
            $(':input[name="editTravelzip"]').prop('disabled', true);
            $(this).parents('.zipmiles').find('.zipcode_pro_mag').html('<img src=' + baseurl + 'assets/ziploader.gif >');
            //console.log($('.zipcodeID[value=10013]').length);
            var count = 0;
            $(".zipcodeID").each(function (index) {

                if ($(this).val() == zipval) {
                    count = count + 1;

                }
            });

            $(".state").each(function (index) {

                if ($(this).val() != '' && $(this).parents('.zipmiles').find('.icheck.zip_mode:checked').val() == 2) {
                    state.push($(this).val());

                }
            });



            //console.log(count);
            if (count > 1) {
                t.html('<font color=red>This zip code is already added.</font>');
                return false;
            }
            $.ajax({
                type: "POST",
                url: baseurl + 'User/chkZipcode/',
                data: 'zipcode=' + zipval + '&states=' + state,
                success: function (data) {
                    var Obj = JSON.parse(data);

                    var size = $('.zipcode_pro_mag:empty').length + 1;
                    var size1 = $('.zipcode_pro_mag').length;


                    if (Obj['searchzipcode'] == '0')
                    {
                        t.html('<font color=red>Sorry! we are not available at this location.</font>');
                        return false;
                    } else if (Obj['searchzipcode'] == '2') {
                        t.html('<font color=red>This zip code is already in the state that you have selected above.</font>');
                        return false;
                    } else {
                        $(':input[name="editTravelzip"]').prop('disabled', false);
                        t.hide();
                        t.html(null);


                        if (size != size1) {
                            $(':input[name="editTravelzip"]').prop('disabled', true);
                        }
                        /*var x=false;
                         $( "li" ).each(function() {
                         $( this ).toggleClass( "example" );
                         });*/
                        return true;
                    }
                }
            });
        } else {
            $(':input[name="editTravelzip"]').prop('disabled', false);
            t.hide();
            t.html(null);
        }

    });
