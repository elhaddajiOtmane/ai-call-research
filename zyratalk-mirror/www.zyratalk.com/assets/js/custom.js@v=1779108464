function encryptPassword(password){
    if( password && auth_key != undefined && auth_key !=''){
        let encryption = new Encryption();
        var encrypted = encryption.encrypt(password.trim(), auth_key);
        return encrypted;
    }
}
function DecryptPassword(password) {
    if (password && auth_key != undefined && auth_key != '') {
        let encryption = new Encryption();
        var encrypted = encryption.decrypt(password.trim(), auth_key);
        return encrypted;
    }
}

