                    let encryptPass = tokenHash + "+" + rawPassword;

                    // Encrypt the combined string
                    let encryptedPassword = encryptPassword(encryptPass);

                    // Replace the password fieldâ€™s value with the encrypted password
                    password.val(encryptedPassword);
                }

             }catch(ex){}
            var postData = $('#sign-in-form').serializeArray();

            // Debug: Log all form data including captcha token
            console.log("Form data being sent:", postData);
                    $.ajax({
