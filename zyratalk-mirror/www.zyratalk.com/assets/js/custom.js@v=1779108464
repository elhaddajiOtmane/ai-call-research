function convertSourceLanguage(prefered_SourceLanguage = 'en', text) {
    var resp_text = '';
    $.ajax({
        type: "GET",
        url: googleTranslateUrl,
        data: {target: prefered_SourceLanguage, key: google_translate_key, q: text},
        async: false,
        success: function (resp) {
            try {
                if (resp.data.translations[0] != undefined) {
                    var obj = resp.data.translations[0]
                    if (obj.translatedText !== undefined) {
                        if (obj.translatedText != '') {
                            resp_text = obj.translatedText;
                        }
                    }
                }
            } catch (e) {
            }
        }
    });
    return resp_text;
}

function getChatLanguage(anonymous_user_id, chatBot_id) {
    var detectedSourceLanguage = '';
    if (anonymous_user_id != undefined && chatBot_id != undefined) {
        $.ajax({
            url: baseurl + 'welcome/get_chat_lang',
            type: 'POST',
            data: {
                'anonymous_user_id': anonymous_user_id,
                'chatBot_id': chatBot_id
            },
            async: false,
            success: function (data) {
                var obj = JSON.parse(data);
                if (obj.status == 200) {
                    if (obj.data.detectedSourceLanguage != null)
                        detectedSourceLanguage = obj.data.detectedSourceLanguage
                    else
                        detectedSourceLanguage = 'en';
                } else {
                    detectedSourceLanguage = 'en';
                }
            }
        });
        return detectedSourceLanguage;
    }


}





