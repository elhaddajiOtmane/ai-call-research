			columns: [
				{
					data: null,
					render: function (data, type, row, meta) {
						return meta.settings._iDisplayStart + meta.row + 1;
					},
				},
				{ data: "call_provider_id" },
				{ data: "company_name" },
				{ data: "user_name" },
                { data: "sub_user_name" },
				{
                    data: "phone_number",
                    render: function (data, type, row) {
                        return (
                            row.phone_number +
                            (row.retail_number && row.retail_number !== ""
                                ? "<br><small class='text-muted'>Fallback No: " + row.retail_number + "</small>"
                                : "")
                        );
                    },
                },
				{ data: "call_type" },
                {
                    data: "status",
                    render: function (data) {
