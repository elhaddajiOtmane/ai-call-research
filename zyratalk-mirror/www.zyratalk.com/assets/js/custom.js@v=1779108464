            $(csvResult).each(function (index) {
                if (csvResult[index] !== '') {
                    htmllist += '<li number=' + csvResult[index] + '>' + formatephone_numbers(csvResult[index]) + '</li>'
                }
            });
            console.log(csvResult);
            $('.csv').append(htmllist);

