const validateEmailNotification = (email) => {
	let emailRegex = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
	return email.match(emailRegex);
};

function updateEmailNotifications(user_id){
    var checkvalues = [];
    let firstInputEmail = [];
    let firstInputEmailStatus = false;
    let secondInputEmail = [];
    let secondInputEmailStatus = false;
    let thirdInputEmail = [];
    let thirdInputEmailStatus = false;
    var chat_install_email = jQuery("#chat_install_email").val();
    var chat_complete_email = jQuery("#chat_complete_email").val();
    var trial_day_left_email = jQuery("#trial_day_left_email").val();
    var getcheckboxdiv = document.querySelectorAll('#notif_trial .checkboxes');
    getcheckboxdiv.forEach((ele, i) => {
        if(ele.checked){
            checkvalues.push(ele.value);
        }
    });
    
    if (chat_install_email.trim() != '' && !checkvalues.includes('not1')) {
        $('#onlyalert .modal-body').text("Please select first checkbox also.");
        $('#onlyalert').modal();
        return false;
    }

    if(checkvalues.includes('not1')){
        
        if(chat_install_email == ''){
            $('#onlyalert .modal-body').text("Please enter atleast one email in selected checkbox.");
            $('#onlyalert').modal();
            return false;
        }

        // split emails
        chat_install_email.split(',').forEach((emailItem) => {
        const emailvalue = validateEmailNotification(emailItem.trim());
            if(emailvalue === null){
                firstInputEmailStatus = true;
            }else{
                firstInputEmail.push(emailItem.trim());
            }
        });
       
        if (firstInputEmailStatus) {
            $('#onlyalert .modal-body').text("Please enter valid email address in first input.");
            $('#onlyalert').modal();
            return false;
        }

    }
    
    if (chat_complete_email.trim() != '' && !checkvalues.includes('not2')) {
        $('#onlyalert .modal-body').text("Please select second checkbox also.");
        $('#onlyalert').modal();
        return false;
    } 

    if(checkvalues.includes('not2')){
        
        var chat_complete_count = jQuery("#chat_complete_count").val();
        if(chat_complete_email == ''){
            $('#onlyalert .modal-body').text("Please enter atleast one email in selected checkbox.");
            $('#onlyalert').modal();
            return false;
        }

        // split emails
        chat_complete_email.split(',').forEach((emailItem1) => {
        const emailvalue1 = validateEmailNotification(emailItem1.trim());
            if(emailvalue1 === null){
                secondInputEmailStatus = true;
            }else{
                secondInputEmail.push(emailItem1.trim());
            }
        });
        
        if (secondInputEmailStatus) {
            $('#onlyalert .modal-body').text("Please enter valid email address in second input.");
            $('#onlyalert').modal();
            return false;
        }
    }

    if (trial_day_left_email.trim() != '' && !checkvalues.includes('not3')) {
        $('#onlyalert .modal-body').text("Please select third checkbox also.");
        $('#onlyalert').modal();
        return false;
    }

    if(checkvalues.includes('not3')){
        
        var trial_day_left = jQuery("#trial_day_left").val();
        if(trial_day_left_email == ''){
            $('#onlyalert .modal-body').text("Please enter atleast one email in selected checkbox.");
            $('#onlyalert').modal();
            return false;
        }

        // split emails
        trial_day_left_email.split(',').forEach((emailItem2) => {
        const emailvalue2 = validateEmailNotification(emailItem2.trim());
            if(emailvalue2 === null){
                thirdInputEmailStatus = true;
            }else{
                thirdInputEmail.push(emailItem2.trim());
            }
        });
        
        if (thirdInputEmailStatus) {
            $('#onlyalert .modal-body').text("Please enter valid email address in third input.");
            $('#onlyalert').modal();
            return false;
        }
    }

    var userStatus = jQuery.ajax({
        url: baseurl + "admin/updateUserEmailNotifications",
        method: "POST",
        data: { 
            user_id: user_id, 
            chat_install_email: firstInputEmail.length > 1 ? firstInputEmail.join(',') : firstInputEmail.join(''), 
            chat_complete_email: secondInputEmail.length > 1 ? secondInputEmail.join(',') : secondInputEmail.join(''), 
            chat_complete_count: chat_complete_count, 
            trial_day_left_email: thirdInputEmail.length > 1 ? thirdInputEmail.join(',') : thirdInputEmail.join(''), 
            trial_day_left: trial_day_left, checkvalues: checkvalues 
        },
        cache: false,
    });
    var obj = 'Notification data has been updated successfully.';
    $('#onlyalert .modal-body').text(obj);
    $('#onlyalert').modal();
    return userStatus;
}

