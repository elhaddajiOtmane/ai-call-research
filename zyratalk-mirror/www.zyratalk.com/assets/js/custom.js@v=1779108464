function Unix_timestamp(t)
{
    var dt = new Date(t * 1000);
    var hr = dt.getHours();
    var m = "0" + dt.getMinutes();
    var s = "0" + dt.getSeconds();
    return dt.getDate() + " " + dt.getMonth() + " " + dt.getFullYear() + " " + hr + ':' + m.substr(-2) + ':' + s.substr(-2);
    //return dt.getDate() +" "+ dt.getDate() +" "+ dt.getFullYear() + "-" + hr + ':' + m.substr(-2) + ':' + s.substr(-2);
}

