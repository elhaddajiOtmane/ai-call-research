function copyShortElement(obj) {
    if (document.getElementById('short_url').value == '') {
        return;
    }
    jQuery("#short_url").prop("readonly",false);
    var currentEl = jQuery(obj);
    if (currentEl.text().toLowerCase().trim() === 'copy') {
        let copyText = document.getElementById('short_url');
        copyText.select();
        document.execCommand("copy");
        currentEl.text("Copied");

        setTimeout(function () {
            currentEl.text("Copy");
            jQuery("#short_url").prop("readonly",true);
        }, 2000);

    } else if (currentEl.text().toLowerCase().trim() === 'copied') {
        currentEl.text("Copy");
    }
}
